{
  "name": "faceit-overlay-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Tray app that finds your current FACEIT match and reports it to your overlay server",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.faceitoverlays.relay",
    "productName": "FACEIT Overlay Relay",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  }
}
